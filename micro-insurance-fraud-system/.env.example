# Database connection string
DATABASE_URL=postgresql://postgres:password@postgres:5432/fraud_db

# Redis connection string
REDIS_URL=redis://redis:6379/0

# AT API credentials
AT_API_KEY=your_at_api_key_here
AT_USERNAME=your_at_username_here

# Dograh voice platform parameters
DOGRAH_API_KEY=your_dograh_api_key_here
DOGRAH_API_TOKEN=your_dograh_api_key_here
DOGRAH_API_URL=https://api.dograh.com
DOGRAH_WORKFLOW_ID=9611
DOGRAH_TELEPHONY_CONFIG_ID=963

# Secret key for session/encryption security
SECRET_KEY=your_secret_key_here

# Postgres base configuration (used in docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fraud_db
